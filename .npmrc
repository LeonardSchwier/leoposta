# Leoforma is installed from its GitHub release asset (a tarball URL with a lockfile
# integrity hash). npm 11 blocks remote tarballs by default; "root" allows them only
# for dependencies this project declares itself, never for transitive ones.
allow-remote=root

# The Leoforma tarball and some packages come from GitHub release downloads, which
# answer 502/503/504 now and then. Retry with a growing pause instead of failing the
# whole install or the container build; a checksum mismatch still fails at once.
fetch-retries=6
fetch-retry-factor=3
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=180000
