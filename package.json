{
  "name": "leoposta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-token.js && vite",
    "build": "node scripts/dev-token.js && vite build",
    "build:desktop": "LEOPOSTA_DESKTOP=1 VITE_LEOPOSTA_TOKEN=injected-by-desktop-shell vite build --outDir dist-desktop --emptyOutDir",
    "preview": "vite preview",
    "server": "node scripts/dev-token.js && node server/index.js",
    "start": "npm run server & npm run dev",
    "bundle:backend": "bash scripts/bundle-backend.sh",
    "tauri": "tauri",
    "tauri:dev": "npm run bundle:backend && tauri dev",
    "tauri:build": "tauri build",
    "install:desktop": "bash scripts/install-desktop.sh",
    "test": "vitest run",
    "test:server": "node --test \"server/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:real": "bash tests/stack/run-e2e.sh",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --threshold error",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && npm run check:svelte",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "setup": "npm ci && playwright install chromium",
    "check": "npm run typecheck && npm test && npm run test:server && npm run build",
    "check:redos": "node scripts/check-redos.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "31.0.0",
    "smtp-server": "^3.21.4",
    "svelte": "^5.25.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@leonardschwier/leoforma": "https://github.com/LeonardSchwier/leoforma/releases/download/v0.2.0/leonardschwier-leoforma-0.2.0.tgz",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "imapflow": "^1.0.190",
    "mailparser": "^3.9.39",
    "nodemailer": "10.4.0",
    "openpgp": "^6.3.2",
    "sanitize-html": "2.18.1"
  }
}
