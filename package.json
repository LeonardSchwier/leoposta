{
  "name": "leoposta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-token.js && vite",
    "build": "node scripts/dev-token.js && vite build",
    "preview": "vite preview",
    "server": "node scripts/dev-token.js && node server/index.js",
    "start": "npm run server & npm run dev",
    "bundle:backend": "bash scripts/bundle-backend.sh",
    "tauri": "tauri",
    "tauri:dev": "npm run bundle:backend && tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:server": "node --test server",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "setup": "npm ci && playwright install chromium",
    "check": "npm run typecheck && npm test && npm run test:server && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.15.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "31.0.0",
    "svelte": "^5.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.2.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@leonardschwier/leoforma": "https://github.com/LeonardSchwier/leoforma/releases/download/v0.2.0/leonardschwier-leoforma-0.2.0.tgz",
    "@tanstack/solid-store": "^0.11.2",
    "@types/dompurify": "^3.0.5",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "imapflow": "^1.0.190",
    "mailparser": "^3.9.39",
    "nodemailer": "10.4.0",
    "openpgp": "^6.3.2",
    "sanitize-html": "2.18.1",
    "vite-plugin-pwa": "^2.0.0"
  }
}
